# Google Cloud Project & Document AI Layout Parser Configuration
GCP_PROJECT_ID=<YOUR_PROJECT_ID>
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=<YOUR_LAYOUT_PROCESSOR_ID>

# Cloud Storage Buckets
GCS_INPUT_BUCKET=your-docai-input-bucket
GCS_OUTPUT_BUCKET=your-docai-output-bucket

# Vertex AI Embeddings & Grounded Generation
VERTEX_EMBEDDING_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_CHAT_LOCATION=global
VERTEX_CHAT_MODEL=gemini-3-flash-preview

# AlloyDB for PostgreSQL Connection (via AlloyDB Auth Proxy or Private IP)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-alloydb-password
